# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/techfest2026?retryWrites=true&w=majority
MONGO_URI=your_mongodb_atlas_connection_string

# JWT Secret Key (At least 32 characters)
JWT_SECRET=techfest_2026_super_secret_jwt_key_at_least_32_chars_long

# Allowed Frontend Client Origin for CORS
CLIENT_ORIGIN=http://localhost:5173

# Environment (development or production)
NODE_ENV=development

# Backend Server Port
PORT=5000
